 "insights": [
  { "key": "overlap", "title": "箱にならない形を「なる」と答えやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r2.quiz", "detail.type": "valid?", "detail.valid": false }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "箱にならない形の問題で {n}問中{w}問を「なる」と答えています。",
   "body": "面と面が重なる場所を頭の中で追うのは、まだ難しい段階です。6枚の面がどこへ動くかを、一度に全部想像しようとしているのかもしれません。",
   "home": "ティッシュ箱や菓子箱を辺にそって切り開き、もう一度たたむ遊びがおすすめです。「この面はどこに来るかな」と1枚ずつ指さしながらたたむと、重なりに気づきやすくなります。" },
  { "key": "cautious", "title": "箱になる形を「ならない」と答えやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r2.quiz", "detail.type": "valid?", "detail.valid": true }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "箱になる展開図の問題で {n}問中{w}問を「ならない」と答えています。",
   "body": "見慣れない並び方を見ると、慎重になって「ならない」を選んでいるようです。十字形以外にも箱になる形が11種類あることを、まだ知らない段階です。",
   "home": "「ずかん」を一緒に開き、見つけた形を指でたどってみてください。「こんな形でも箱になるんだね」と声をかけると、見慣れない形への抵抗が減ります。" },
  { "key": "opp", "title": "向かい合う面の見つけ方を練習中", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r2.quiz", "detail.type": "opp" }, "minN": 2, "minWrong": 2 },
   "obs": "向かい合う面の問題で {n}問中{w}問がまちがいでした。",
   "body": "展開図の上で、となり合う面と向かい合う面の区別がまだついていない段階です。",
   "home": "サイコロを見ながら「1の反対は6」のように、向かい合う目を当てる遊びが役に立ちます。展開図では、となりの面は向かい合わないことを一緒に確かめてください。" },
  { "key": "count", "title": "辺と頂点の数があいまい", "tag": "2年の内容", "reviewed": false,
   "test": { "type": "count", "where": { "kind": "review", "detail.id": ["r-edge", "r-vert"], "correct": false }, "min": 2 },
   "obs": "思い出し問題の「辺の数」「頂点の数」で {n}回まちがえています。",
   "body": "辺（面と面の境目）と頂点（かど）の言葉と数が、まだ結びついていない様子です。2年で習ったあと、4年まで出てこないため忘れやすいところです。",
   "home": "身近な箱のかどに付せんを貼りながら一緒に数えると、頂点は8つだと体で覚えられます。「さわる」の「へん」「ちょうてん」で数える様子を見るのも効果があります。" },
  { "key": "cuboid", "title": "直方体の面や辺の長さを見分ける練習中", "tag": "2年の内容", "reviewed": false,
   "test": { "type": "sum", "where": { "kind": ["r2.stamp", "r2.hone"] }, "field": "detail.miss", "min": 3 },
   "obs": "面の組み合わせや、ひごの長さで {s}回まちがえています。",
   "body": "直方体には同じ形の面が2枚ずつ、同じ長さの辺が4本ずつあることを、まだ見通せていない段階です。",
   "home": "お菓子の箱の面を紙に写し取り、切り抜いて重ねてみてください。ぴったり重なる2枚を見つける体験が、そのまま学校の学習につながります。" },
  { "key": "cards", "title": "6枚の面で箱ができるかを見分ける練習中", "tag": "2年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r2.card-quiz" }, "minN": 3, "minWrong": 2, "ratio": 0.5 },
   "obs": "「この6まいで箱ができる？」で {n}問中{w}問がまちがいでした。",
   "body": "同じ形が2枚ずつそろっているか、辺の長さが合っているかを、まだ同時に見られない段階です。",
   "home": "空き箱を1つ切り開き、6枚の面を並べて「同じ形はどれとどれ？」と組にしてみてください。組ができたら、もう一度テープで箱に戻すと確かめられます。" }
