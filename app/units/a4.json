 "insights": [
  {
   "key": "a4-side",
   "type": "side",
   "title": "辺の長さで角の大きさを決めている",
   "reviewed": false,
   "test": {
    "type": "count",
    "where": {
     "kind": [
      "a4.make"
     ],
     "detail.mistake": "side"
    },
    "min": 2
   },
   "obs": "辺の長さがちがう2つの角を比べる問題で、辺の長いほうを大きいと答えるまちがいが{n}回ありました。",
   "body": "角の大きさは、辺の長さではなく、2本の辺の開きぐあい（回転の大きさ）で決まります。辺を長く描くと大きく見えるため、見た目で判断している段階です。",
   "home": "紙を2枚重ねて開き、「長い紙でも短い紙でも、開きぐあいが同じなら同じ角」と一緒に確かめてみてください。",
   "tag": "4年の内容"
  },
  {
   "key": "a4-scale",
   "type": "scale",
   "title": "分度器の内側と外側の目もりを読みちがえている",
   "reviewed": false,
   "test": {
    "type": "count",
    "where": {
     "kind": [
      "a4.read",
      "a4.make"
     ],
     "detail.mistake": "scale"
    },
    "min": 2
   },
   "obs": "分度器で角を読む・作る問題で、もう一方の目もり（180°から引いた値）を答えるまちがいが{n}回ありました。",
   "body": "分度器には内側と外側に2つの目もりがあります。0の線を辺に合わせたあと、その辺の側で0から始まる目もりを読みます。どちらの目もりかを選ぶ段階です。",
   "home": "「この角は直角より大きい？小さい？」と先に見当をつけてから読むと、読みちがいに自分で気づけます。",
   "tag": "4年の内容"
  },
  {
   "key": "a4-reflex",
   "type": "reflex",
   "title": "180°より大きい角で、小さいほうの角を答えている",
   "reviewed": false,
   "test": {
    "type": "count",
    "where": {
     "kind": [
      "a4.read"
     ],
     "detail.mistake": "reflex"
    },
    "min": 1
   },
   "obs": "180°より大きい角の問題で、残りの小さいほうの角を答えるまちがいが{n}回ありました。",
   "body": "180°より大きい角は、360°から小さいほうの角を引くか、180°にたして求めます。どこからどこまでの角かを見分ける段階です。",
   "home": "時計の長い針で「ひとまわりは360°」を確かめ、「半分より多く回ったね」と言葉にしてみてください。",
   "tag": "4年の内容"
  },
