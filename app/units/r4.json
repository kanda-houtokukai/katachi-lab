 "insights": [
  { "key": "overlap", "title": "箱にならない形を「なる」と答えやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.net-quiz", "detail.valid": false }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "箱にならない形の問題で {n}問中{w}問を「なる」と答えています。",
   "body": "辺の長さが合わない所や、面が重なる所を、頭の中で追いきれていない段階です。",
   "home": "菓子箱を辺にそって切り開き、たたみ直す遊びがおすすめです。「この面はどこに来るかな」と1枚ずつ指さしながらたたむと、重なりに気づきやすくなります。" },
  { "key": "cautious", "title": "箱になる見慣れない形を「ならない」と答えやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.net-quiz", "detail.valid": true }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "箱になる展開図の問題で {n}問中{w}問を「ならない」と答えています。",
   "body": "立方体の展開図は11種類、直方体は54種類あります。見慣れない並び方を見ると、慎重になって「ならない」を選んでいるようです。",
   "home": "「ずかん」を一緒に開き、見つけた展開図をたどってみてください。「こんな形でも箱になるんだね」と声をかけると、見慣れない形への抵抗が減ります。" },
  { "key": "opp", "title": "向かい合う面の見つけ方を練習中", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.opp" }, "minN": 2, "minWrong": 2 },
   "obs": "向かい合う面の問題で {n}問中{w}問がまちがいでした。",
   "body": "展開図の上で、となり合う面と向かい合う面の区別がまだついていない段階です。",
   "home": "サイコロを見ながら「1の反対は6」のように向かい合う目を当てる遊びが役に立ちます。「つくる」の「さいころを つくる」もおすすめです。" },
  { "key": "edgevert", "title": "重なる辺・頂点を、となりの辺と取り違えやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": ["r4.edge-match", "r4.vertex-match"], "correct": [true, false] }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "重なる辺・頂点の問題で {n}問中{w}問がまちがいでした。",
   "body": "組み立てたときに辺がどこへ動くかを、まだ1本ずつ追えていない段階です。",
   "home": "菓子箱を切り開き、重なる辺に同じ色のシールを貼ってから組み立て直してみてください。同じ色どうしがくっつく様子が、そのまま答えの確かめになります。" },
  { "key": "paraperp", "title": "平行と垂直の取り違え", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.para-perp", "correct": [true, false] }, "minN": 2, "minWrong": 2, "ratio": 0.5 },
   "obs": "平行・垂直の問題で {n}問中{w}問がまちがいでした。",
   "body": "「平行＝どこまでのばしても交わらない」「垂直＝直角に交わる」の言葉と、箱の面や辺の関係がまだ結びついていない段階です。",
   "home": "ティッシュ箱を机に置き、「この面と平行な面は？」「この辺に直角にくっつく辺は？」と指さしで当てっこをしてみてください。" },
  { "key": "sketch", "title": "見取図で、見えない辺を実線でかいてしまう", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.sketch" }, "minN": 2, "minWrong": 2 },
   "obs": "見取図の問題で {n}問中{w}問がまちがいでした。",
   "body": "箱の後ろ側に隠れて見えない辺を、見えている辺と区別できていない段階です。",
   "home": "透明なケースや、針金で作った骨組みの箱を見せ、「前から見ると、どの辺が後ろに隠れるかな」と話してみてください。" },
  { "key": "position", "title": "位置の表し方で、横と縦の順を逆にしやすい", "tag": "4年の内容", "reviewed": false,
   "test": { "type": "wrongRate", "where": { "kind": "r4.position" }, "minN": 2, "minWrong": 2 },
   "obs": "位置の表し方の問題で {n}問中{w}問がまちがいでした。",
   "body": "基準の点から「横にいくつ、縦にいくつ（高さいくつ）」と順に数える約束が、まだ定まっていない段階です。",
   "home": "部屋のすみを0にして、「横に3歩、縦に2歩」で宝物を置く遊びがおすすめです。言う順番をそろえるのがこつです。" }
